table loan_fact
	lineageTag: 1972ef92-5778-4dc5-a276-d8c36964d1b3

	measure '% Default Rate' = divide(calculate(countrows(loan_fact), loan_fact[is default] = 1), calculate(countrows(loan_fact), loan_fact[is default] in {0, 1}))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a8697298-b84a-49d8-b782-848d22ef4fe9

	measure 'Total Potential Interest Loss' =
			
			VAR FP_Yield =
			    CALCULATE (
			        DIVIDE ( SUM ( loan_fact[total_rec_int] ), SUM ( loan_fact[loan_amnt] ) ),
			        REMOVEFILTERS ( loan_fact[is default] ),
			        loan_fact[loan_status] = "Fully Paid"
			    )
			VAR CO_Principal =
			    CALCULATE ( SUM ( loan_fact[loan_amnt] ), loan_fact[loan_status] = "Charged Off" )
			RETURN
			    CO_Principal * FP_Yield
		formatString: $#,##0.0;-$#,##0.0
		lineageTag: 1d8e48a6-5012-4151-a736-fcb8e6e26d5e

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total plus' = calculate(sum(loan_fact[total_pymnt]) - sum(loan_fact[loan_amnt]), loan_fact[is default] = 0)
		formatString: $#,##0.0;-$#,##0.0
		lineageTag: 569eda4e-7934-4602-b911-5a80dd2c61d5

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Total minus' = calculate(sum(loan_fact[total_pymnt]) - sum(loan_fact[loan_amnt]), loan_fact[is default] = 1)
		formatString: $#,##0.0;-$#,##0.0
		lineageTag: 71b6e061-8463-47f5-b4bd-a1927fe2f794

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Count Fully Paid' =
			
			CALCULATE(
			    COUNTROWS( loan_fact ),
			    FILTER( loan_fact, loan_fact[is default] = 0)
			)
		formatString: 0
		lineageTag: 76e37e65-ed52-4445-9842-37cc53d4b7a3

	measure 'Total margin' = divide([Total plus]+[Total minus], [Total plus])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6b7fc14e-aba0-4e41-a2d4-f24825f59687

	measure 'Profit Yearly' = ```
			
			VAR TotalValue = SUM(loan_fact[Total outcome col])
			VAR NumberOfYears = DISTINCTCOUNT('date table'[Year])
			RETURN
			DIVIDE(TotalValue, NumberOfYears)
			
			```
		lineageTag: 68345988-da48-4d84-afd9-d43df74901d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Month Sales' = ```
			CALCULATE(sum(loan_fact[Total outcome col]), DATEADD(loan_fact[issue_d], -1, month))
			
			```
		lineageTag: 0568fda0-451b-4037-8092-b2d55257c897

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'total profit %' =
			
			DIVIDE (
			    sum(loan_fact[Total outcome col]),
			    CALCULATE (
			        sum(loan_fact[Total outcome col]),
			        REMOVEFILTERS ( loan_fact[term], loan_fact[addr Region], loan_fact[issue_d] )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b298cf1a-555f-4ac4-a7ea-7275b2aec446

	measure 'Profit Change %' =
			
			VAR _isMonth = HASONEVALUE('date table'[Month Index])
			VAR _isYear  = HASONEVALUE('date table'[Year])
			VAR _y   = MAX('date table'[Year])
			VAR _mi  = MAX('date table'[Month Index])
			VAR _cur = SUM(loan_fact[Total outcome col])
			VAR _prev =
			    SWITCH(
			        TRUE(),
			        _isMonth, CALCULATE(SUM(loan_fact[Total outcome col]), REMOVEFILTERS('date table'), 'date table'[Month Index] = _mi - 1),
			        _isYear,  CALCULATE(SUM(loan_fact[Total outcome col]), REMOVEFILTERS('date table'), 'date table'[Year] = _y - 1)
			    )
			RETURN
			IF(NOT ISBLANK(_prev), DIVIDE(_cur - _prev, ABS(_prev)))
		lineageTag: c346d9e4-7a70-49e7-8621-ca069da80843

		formatStringDefinition = "+0.00%;-0.00%;0.00%"

	measure 'total count %' =
			
			DIVIDE (
			    countrows(loan_fact),
			    CALCULATE (
			        countrows(loan_fact),
			        REMOVEFILTERS ( loan_fact[term], loan_fact[addr Region], loan_fact[issue_d] )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6add9db1-40d6-4fb1-ae6b-d235a477ec32

	measure 'Avg YoY Profit % Before 2016' =
			
			VAR _cut = 2016
			VAR _t =
			    ADDCOLUMNS(
			        FILTER(VALUES('date table'[Year]), 'date table'[Year] < _cut),
			        "@cur", CALCULATE(SUM(loan_fact[Total outcome col])),
			        "@prev",
			            VAR _y = 'date table'[Year]
			            RETURN
			                CALCULATE(
			                    SUM(loan_fact[Total outcome col]),
			                    REMOVEFILTERS('date table'),
			                    'date table'[Year] = _y - 1
			                )
			    )
			VAR _valid = FILTER(_t, NOT ISBLANK([@prev]) && [@prev] > 0)
			RETURN
			AVERAGEX(_valid, DIVIDE([@cur] - [@prev], [@prev]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ce1f1763-aaae-4180-8015-7103b40c5095

	measure 'Total outcome measure' = sum(loan_fact[total_pymnt]) - sum(loan_fact[loan_amnt])
		lineageTag: d50f9800-79a1-4aa6-ad55-1e8e7746a481

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg YoY Profit % After 2016' =
			
			VAR _cut = 2016
			VAR _t =
			    ADDCOLUMNS(
			        FILTER(VALUES('date table'[Year]), 'date table'[Year] >= _cut),
			        "@cur", CALCULATE(SUM(loan_fact[Total outcome col])),
			        "@prev",
			            VAR _y = 'date table'[Year]
			            RETURN
			                CALCULATE(
			                    SUM(loan_fact[total outcome col]),
			                    REMOVEFILTERS('date table'),
			                    'date table'[Year] = _y - 1
			                )
			    )
			VAR _valid = FILTER(_t, NOT ISBLANK([@prev]) && [@prev] > 0)
			RETURN
			AVERAGEX(_valid, DIVIDE([@cur] - [@prev], [@prev]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7c78d7b4-0b92-42b8-b3e4-960b43adad7c

	measure 'recovery %' = calculate(divide(sum(loan_fact[recoveries]), sum(loan_fact[loan_amnt])), loan_fact[is default] = 1)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2aab4cb5-1f5c-41ad-bf52-fbe62db5ee79

