	column 'Default rate (bins)' =
			IF(
				ISBLANK('location data'[Default rate]),
				BLANK(),
				IF(
					'location data'[Default rate] >= 0,
					ROUNDDOWN('location data'[Default rate] / 0.02, 0) * 0.02,
					ROUNDUP('location data'[Default rate] / 0.02, 0) * 0.02
				)
